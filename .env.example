# Copy to .env.local and fill in what you use.

# --- AI features ---
# Required for: prescription extraction, weekly analysis, check-in drafts, doc chat.
ANTHROPIC_API_KEY=
# Claude model override (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Required for document chat (RAG embeddings, voyage-4).
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4

# --- Database ---
# Leave unset to use the embedded PGlite database at .data/pglite (zero config).
# Point at a real Postgres (with the pgvector extension available) to use it instead.
# DATABASE_URL=postgres://user:pass@localhost:5432/showprep

# --- Security ---
# Bearer token the mobile companion must send to /api/ingest/*.
# Leave unset to allow unauthenticated ingest in local dev.
INGEST_API_KEY=

# Single-user login password. Leave unset to disable the login gate entirely.
APP_PASSWORD=

# --- Portfolio demo (optional) ---
# When set, the login page shows a "Portfolio demo" card with a one-click
# "Enter demo" button. Set it EQUAL to APP_PASSWORD so the button logs in.
# Leave unset for a private (non-demo) deployment.
# NEXT_PUBLIC_DEMO_PASSWORD=
